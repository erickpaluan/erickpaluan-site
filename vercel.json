{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/projetos", "destination": "/projects", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
